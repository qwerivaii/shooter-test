function roundRect(x, y, w, h, r) {
  ctx.beginPath();
  ctx.moveTo(x + r, y);
  ctx.arcTo(x + w, y, x + w, y + h, r);
  ctx.arcTo(x + w, y + h, x, y + h, r);
  ctx.arcTo(x, y + h, x, y, r);
  ctx.arcTo(x, y, x + w, y, r);
  ctx.closePath();
}

function drawHeart(x, y, filled) {
  ctx.save();
  ctx.translate(x, y);
  ctx.beginPath();
  const s = 7;
  ctx.moveTo(0, s * 0.65);
  ctx.bezierCurveTo(-s * 1.6, -s * 0.5, -s * 0.7, -s * 1.5, 0, -s * 0.55);
  ctx.bezierCurveTo(s * 0.7, -s * 1.5, s * 1.6, -s * 0.5, 0, s * 0.65);
  ctx.closePath();
  if (filled) {
    ctx.fillStyle = '#ff4d6d';
    ctx.shadowColor = 'rgba(255,60,100,0.9)';
    ctx.shadowBlur = 8;
    ctx.fill();
    ctx.shadowBlur = 0;
  } else {
    ctx.strokeStyle = 'rgba(255,120,150,0.45)';
    ctx.lineWidth = 1.3;
    ctx.stroke();
  }
