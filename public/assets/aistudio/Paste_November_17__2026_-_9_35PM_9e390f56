/* ==================================================================
   LIFECYCLE
   ================================================================== */

function startGame() {
  AudioEngine.resume();

  game.state = 'playing';
  game.score = 0;
  game.wave = 0;
  game.waveActive = false;
  game.waveTimer = 0;
  game.spawnTimer = 0;
  game.spawnQueue.length = 0;
  game.shake = 0;
  game.shakeMag = 0;
  game.hitFlash = 0;
  game.deathDelay = 0;
  game.bossActive = false;
  game.waveBanner = 0;

  resetPlayer();

  bullets.length = 0;
  enemies.length = 0;
  particles.length = 0;
  shockwaves.length = 0;
  powerups.length = 0;

  overT = 0;
  newRecord = false;

  canvas.classList.add('playing');
  startWave(1);
}

function pauseGame() {
  if (game.state !== 'playing') return;
  game.state = 'paused';
  canvas.classList.remove('playing');
}

function resumeGame() {
  if (game.state !== 'paused') return;
  game.state = 'playing';
  AudioEngine.resume();
  canvas.classList.add('playing');
}

function triggerGameOver() {
  game.state = 'gameover';
  canvas.classList.remove('playing');

  newRecord = game.score > game.highScore;
  if (newRecord) {
    game.highScore = game.score;
    localStorage.setItem('gd_highscore', String(game.highScore));
  }
  if (game.wave > game.bestWave) {
    game.bestWave = game.wave;
    localStorage.setItem('gd_bestwave', String(game.bestWave));
  }

  AudioEngine.gameOver();
  overT = 0;
}

/* ==================================================================
   UPDATE
   ================================================================== */

function update(dt) {
  game.time += dt;

  // Starfield selalu bergerak
  updateStars(dt);

  if (game.state === 'start') return;
  if (game.state === 'paused') return;
  if (game.state === 'gameover') return;

  // === PLAYING ===
  updatePlayer(dt);
  updateBullets(dt);
  updateEnemies(dt);
  updatePowerups(dt);
  updateParticles(dt);

  // === Wave progression ===
  updateWave(dt);

  // === Collisions ===
  handleCollisions();

  // === Screen shake decay ===
  if (game.shake > 0) {
    game.shake -= dt;
    if (game.shake <= 0) { game.shake = 0; game.shakeMag = 0; }
  }

  if (game.hitFlash > 0) game.hitFlash = Math.max(0, game.hitFlash - dt);

  // === Death delay -> game over ===
  if (!player.alive) {
    game.deathDelay -= dt;
    if (game.deathDelay <= 0) triggerGameOver();
  }
}

/* ==================================================================
   RENDER
   ================================================================== */

function render(dt) {
  ctx.setTransform(1, 0, 0, 1, 0, 0);
  const dpr = Math.min(window.devicePixelRatio || 1, 2);
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

  ctx.clearRect(0, 0, W, H);

  // Latar ruang angkasa dengan nebula halus
  const bg = ctx.createLinearGradient(0, 0, 0, H);
  bg.addColorStop(0, '#060a18');
  bg.addColorStop(0.5, '#080d1e');
  bg.addColorStop(1, '#0a1024');
  ctx.fillStyle = bg;
  ctx.fillRect(0, 0, W, H);

  // Nebula glow
  const ng = ctx.createRadialGradient(W * 0.25, H * 0.2, 10, W * 0.25, H * 0.2, 340);
  ng.addColorStop(0, 'rgba(50,80,190,0.16)');
  ng.addColorStop(1, 'rgba(0,0,0,0)');
  ctx.fillStyle = ng;
  ctx.fillRect(0, 0, W, H);

  const ng2 = ctx.createRadialGradient(W * 0.8, H * 0.75, 10, W * 0.8, H * 0.75, 300);
  ng2.addColorStop(0, 'rgba(150,40,180,0.12)');
  ng2.addColorStop(1, 'rgba(0,0,0,0)');
  ctx.fillStyle = ng2;
  ctx.fillRect(0, 0, W, H);

  // === Screen shake ===
  let sx = 0, sy = 0;
  if (game.shake > 0) {
    const mag = game.shakeMag * (game.shake > 0 ? 1 : 0);
    sx = rand(-mag, mag);
    sy = rand(-mag, mag);
  }

  ctx.save();
  ctx.translate(sx, sy);

  // Starfield
  drawStars();

  if (game.state === 'start') {
    drawStartScreen(dt);
  } else if (game.state === 'playing' || game.state === 'paused') {
    // World
    drawPowerups();
    drawParticles();
    drawBullets();

    for (const e of enemies) drawEnemy(e);

    drawPlayer();

    ctx.restore();

    // === Screen flash (damage / powerup) ===
    if (game.hitFlash > 0) {
      ctx.save();
      ctx.globalAlpha = clamp(game.hitFlash * 1.6, 0, 0.55);
      ctx.fillStyle = '#ff3344';
      ctx.fillRect(0, 0, W, H);
      ctx.restore();
      ctx.globalAlpha = 1;
    }

    drawHUD();
    drawWaveBanner(game.state === 'paused' ? 0 : dt);

    if (game.state === 'paused') drawPauseScreen();
    return;
  } else if (game.state === 'gameover') {
    drawPowerups();
    drawParticles();
    drawBullets();
    for (const e of enemies) drawEnemy(e);
    ctx.restore();

    drawGameOverScreen(dt);
    return;
  }

  ctx.restore();
  ctx.globalAlpha = 1;
  ctx.shadowBlur = 0;
}

/* ==================================================================
   MAIN LOOP
   ================================================================== */

let lastTime = performance.now();

function frame(now) {
  let dt = (now - lastTime) / 1000;
  lastTime = now;

  // Clamp dt untuk mencegah lompatan besar saat tab tidak aktif
  if (dt > 0.05) dt = 0.05;
  if (dt < 0) dt = 0;

  update(dt);
  render(dt);

  requestAnimationFrame(frame);
}

// Reset lastTime saat tab kembali aktif (hindari dt besar)
document.addEventListener('visibilitychange', () => {
  lastTime = performance.now();
  if (document.hidden && game.state === 'playing') pauseGame();
});

/* ==================================================================
   BOOT
   ================================================================== */

// Prewarm audio context setelah interaksi pertama
window.addEventListener('pointerdown', () => AudioEngine.resume(), { once: true });
window.addEventListener('keydown', () => AudioEngine.resume(), { once: true });

requestAnimationFrame(frame);
</script>
